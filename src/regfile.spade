use std::mem;

pub struct ReadPort<#uint W, D> {
    addr: inv uint<W>,
    out: D
}

pub struct WritePort<#uint W, D> {
    addr: inv uint<W>,
    write: inv Option<D>
}

pub entity regfile(clk: clock) -> (
        ReadPort<5, uint<32>>,
        ReadPort<5, uint<32>>,
        WritePort<5, uint<32>>
    )
{
    let read_addr0 = port();
    let read_addr1 = port();
    let write_addr = port();
    let write_data = port();


    // The compiler can infer the types but not the number of elements (32) in this
    // case
    let mem = inst mem::clocked_memory::<32, _, _, _>(
        clk,
        [(
            // Bypass writing to the zero register
            write_data.0.is_some() && write_addr.0 != 0,
            write_addr.0,
            write_data.0.unwrap_or_undef(),
        )]
    );


    let r0 = inst std::mem::read_memory(mem, read_addr0.0);
    let r1 = inst std::mem::read_memory(mem, read_addr1.0);

    // Bypass reads the zero register
    let r0 = if read_addr0.0 == 0 {
        0
    } else {
        r0
    };

    let r1 = if read_addr1.0 == 0 {
        0
    } else {
        r1
    };


    (
        ReadPort(read_addr0.1, r0),
        ReadPort(read_addr1.1, r1),
        WritePort(write_addr.1, write_data.1)
    )
}

struct RegfileOut {
    r0: uint<32>,
    r1: uint<32>,
}

entity regfile_tb(
    clk: clock,
    read_addr0: uint<5>,
    read_addr1: uint<5>,
    write_addr: uint<5>,
    write_enable: bool,
    write_data: uint<32>,
) -> RegfileOut {
    let (rp0, rp1, wp) = inst regfile(clk);
    set rp0.addr = read_addr0;
    set rp1.addr = read_addr1;
    set wp.addr = write_addr;
    set wp.write = if write_enable { Some(write_data) } else { None() };
    RegfileOut$(r0: rp0.out, r1: rp1.out)
}
