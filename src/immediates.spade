use lib::control::Insn;

impl Insn {
    fn raw_imm(self) -> uint<25> {
        self.as_bits()[7..32].as_uint()
    }
}

pub enum ImmediateSource {
    I_type,
    S_type,
    B_type,
    J_type,
    U_type,
}

pub fn signext_immediate(insn: Insn, imm_src: ImmediateSource) -> uint<32> {
    let bits = insn.raw_imm().as_bits();

    let imm = match imm_src {
        ImmediateSource::I_type => sext(bits[13..25].as_int()),

        ImmediateSource::S_type => sext(bits[0..5].concat(bits[18..25]).as_int()),

        ImmediateSource::B_type =>
            sext(
                [false]
                .concat(bits[1..5])
                .concat(bits[18..24])
                .concat([bits[0]])
                .concat([bits[24]])
                .as_int()
            ),

        ImmediateSource::J_type =>
            sext(
                [false]
                .concat(bits[14..24])
                .concat([bits[13]])
                .concat(bits[5..13])
                .concat([bits[24]])
                .as_int()
            ),

        ImmediateSource::U_type => [false; 12].concat(bits[5..25]).as_int(),
    };

    imm.as_uint()
}
