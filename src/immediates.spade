pub fn sign_extend(raw_src: uint<25>, imm_src: ImmediateSource) -> int<32> {
    let bits = raw_src.as_bits();

    match imm_src {
        ImmediateSource::I_type => sext(bits[13..25].as_int()),

        ImmediateSource::S_type => sext(bits[0..5].concat(bits[18..25]).as_int()),

        ImmediateSource::B_type => sext([false]
            .concat(bits[1..5])
            .concat(bits[18..24])
            .concat([bits[0]]).as_int()),

        ImmediateSource::J_type => sext([false]
            .concat(bits[14..24])
            .concat([bits[13]])
            .concat(bits[5..13]).as_int()),

        ImmediateSource::U_type => [false; 12].concat(bits[5..25]).as_int(),
    }
}
